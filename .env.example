# Variables del entorno local con Docker Compose.
# Copia este archivo como .env (cp .env.example .env) y cambia los valores.
# Nunca subas el .env al repositorio. Estos valores son solo de ejemplo.

# Puerto del anfitrion donde se publica el API Gateway.
GATEWAY_PORT=8080

# Superusuario de PostgreSQL (solo lo usa el script de infra/postgres/).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-postgres

# Contrasena del usuario de base de datos de cada servicio.
CATALOGO_DB_PASSWORD=cambia-catalogo
PEDIDOS_DB_PASSWORD=cambia-pedidos
RECOMENDAR_DB_PASSWORD=cambia-recomendar
ASISTENTE_DB_PASSWORD=cambia-asistente

# SECRET_KEY de Django de cada servicio.
CATALOGO_SECRET_KEY=cambia-clave-catalogo
PEDIDOS_SECRET_KEY=cambia-clave-pedidos
RECOMENDAR_SECRET_KEY=cambia-clave-recomendar
ASISTENTE_SECRET_KEY=cambia-clave-asistente

# DEBUG de Django para todos los servicios (True solo en desarrollo).
DJANGO_DEBUG=False
