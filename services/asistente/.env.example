# Copia este archivo como .env y ajusta los valores. Nunca subas el .env.

SECRET_KEY=cambia-esta-clave
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,asistente

# Si DB_NAME está vacío o no existe, el servicio usa SQLite (db.sqlite3).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Servicios que consulta el asistente (nombres internos de Docker Compose).
PEDIDOS_URL=http://pedidos:8000
RECOMENDAR_URL=http://recomendar:8000
# Tiempo límite en segundos de cada llamada a otro servicio.
SERVICIOS_TIMEOUT=3

# Ruta del modelo entrenado. Vacía = modelos/intenciones.joblib dentro del servicio.
MODELO_RUTA=
