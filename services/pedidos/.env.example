# Copia este archivo como .env y ajusta los valores. Nunca subas el .env.

SECRET_KEY=cambia-esta-clave
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,pedidos

# Si DB_NAME está vacío o no existe, el servicio usa SQLite (db.sqlite3).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Servicio catalogo (se consulta por HTTP interno para validar el medio y el costo).
CATALOGO_URL=http://catalogo:8000
CATALOGO_TIMEOUT=3

# Procesos de gunicorn dentro del contenedor.
GUNICORN_WORKERS=3
